# Database — absolute path to SQLite file (stored OUTSIDE the repo)
DATABASE_PATH=C:/shabetz-na-data/shabetz.db

# Pepper — global secret appended to passwords before hashing
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PEPPER_SECRET=

# Session — secret for signing session tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
